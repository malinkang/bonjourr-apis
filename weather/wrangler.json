{
	"name": "bonjourr-weather",
	"main": "index.ts",
	"compatibility_date": "2026-05-03",
	"routes": [
		{
			"pattern": "api-weather.YOUR_DOMAIN.com",
			"custom_domain": true
		}
	],
	"limits": {
		"cpu_ms": 30
	},
	"dev": {
		"ip": "127.0.0.1",
		"port": 8888
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	}
}
